# Copy to .env and edit.
# Local MongoDB (docker compose up -d):
MONGODB_URI=mongodb://localhost:27017
# MongoDB Atlas instead:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=phishguard

# Frontend address allowed by CORS (comma separated)
CORS_ORIGINS=http://localhost:5173

# Login tokens. Generate a secret with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-secret-before-you-deploy-0000
JWT_EXPIRE_MINUTES=720

# Emails (comma separated) that become Admin when they register
ADMIN_EMAILS=admin@example.com
